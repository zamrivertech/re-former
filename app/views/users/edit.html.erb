<h1>Edit user</h2>

<%= form_with model: @user do |form| %>
  
  <ul>
    <% @user.errors.each do |error| %>
    <li><%= error.full_message %></li>
    <% end %> 
  </ul>

  <div>
    <%= form.label :username %>
    <%= form.text_field :username %>
  </div>
  <div>
    <%= form.label :email %>
    <%= form.email_field :email %>
  </div>
  <div>
    <%= form.label :password %>
    <%= form.password_field :password %>
  </div>
  <%= form.submit %>
<% end %>

