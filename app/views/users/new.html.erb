<h1>Create a new user</h1>

<%= form_with model: @user do |form| %>
  <div>
    <%= form.label :username %>
    <%= form.text_field :username, placeholder: @username_placeholders.sample %>
  </div>
  <div>
    <%= form.label :email %>
    <%= form.email_field :email, placeholder: @email_placeholders.sample %>
  </div>
  <div>
    <%= form.label :password %>
    <%= form.password_field :password %>
  </div>
  <%= form.submit %> 
<% end %>

